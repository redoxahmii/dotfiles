{
  "layer": "top",
  "ipc": true,
  "position": "top",
  "height": 30,
  "reload_style_on_change": true,
  "layer-shell": {
    "exclusive-zone": true,
    "visibility": "toggleable"
  },
  "modules-left": ["hyprland/workspaces", "hyprland/submap", "custom/spotify"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "custom/pomodoro",
    "custom/power-toggle",
    "pulseaudio",
    // "backlight/slider",
    "network",
    "cpu",
    "memory",
    "battery",
    "tray",
    // "bluetooth",
    "clock"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "urgent": "",
      "focused": "",
      "default": ""
    },
    "persistent-workspaces": {
      "*": 5,
      "HDMI-A-1": 5
    }
  },
  "hyprland/submap": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "hyprland/window": {
    "separate-outputs": true,
    "truncate-text": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": " &#x202c;$1",
      "w .": "Coding  &#x202c;",
      "Stremio - (.*)": "🎥 &#x202c;$1",
      "firefox": " &#x202c;",
      "kitty": " &#x202c;",
      "VLC media player": "󰕼 &#x202c;$1",
      "(.*) - VLC media player": "󰕼 &#x202c;$1"
    },
    "truncate-text-limit": 30
  },
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip": false,
    "format-alt": "{:%A %d %b %Y }"
  },
  "cpu": {
    "format": "{usage}%  ",
    "interval": 5
  },
  "memory": {
    "format": "{}%  ",
    "interval": 5
  },
  // "backlight/slider": {
  //   "min": 0,
  //   "max": 100
  // },
  "battery": {
    "bat": "BAT0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%  {icon}",
    "format-charging": " {capacity}%  <span></span>",
    "format-icons": ["", "", "", "", ""],
    "interval": 5,
    "on-click": "$HOME/.config/waybar/scripts/waybar-battery.sh"
  },
  "network": {
    "max-length": 20,
    "format-wifi": "{essid} ({bandwidthDownBytes}) ",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr}  ",
    "tooltip-format-wifi": "{essid} ({bandwidthDownBytes}) ({signalStrength}%)",
    "format-disconnected": "Disconnected  ⚠",
    "on-click": "nm-connection-editor",
    "interval": 2
  },
  "pulseaudio": {
    //"scroll-step": 1,
    "format": "{volume}%  {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    // ISSUE: icons not working because runs it through easyeffect sink
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""]
    },
    "on-click": "pavucontrol"
  },
  "custom/power-toggle": {
    "format": "{}",
    "max-length": 20,
    "interval": 20,
    "signal": 10,
    "exec": "$HOME/.config/waybar/scripts/power-info.sh",
    "on-click": "$HOME/.config/waybar/scripts/power-toggle.sh; pkill -SIGRTMIN+10 waybar"
  },
  "custom/spotify": {
    "format": "{}",
    "max-length": 40,
    "interval": 30,
    "exec": "$HOME/.config/waybar/scripts/player_status.sh 2> /dev/null",
    "exec-if": "pgrep -f 'chrome|firefox'",
    "on-click": "playerctl play-pause"
  },
  "custom/pomodoro": {
    "format": "{}",
    "return-type": "json",
    // "exec": "~/.local/bin/waybar-module-pomodoro --no-icons -w 1 -s 1 -l 20",
    "exec": "$HOME/.config/waybar/scripts/pomodoro.sh",
    "on-click": "~/.local/bin/waybar-module-pomodoro toggle",
    "on-click-right": "~/.local/bin/waybar-module-pomodoro reset"
  }
  // "bluetooth": {
  //   "format": " {status}",
  //   "format-disabled": "Hello",
  //   "format-off": " ",
  //   "interval": 4,
  //   "on-click": "blueberry"
  // }
}
